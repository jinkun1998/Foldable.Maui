<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<PackageId>Foldable.Maui</PackageId>
		<Version>1.0.0</Version>
		<Authors>Quoc Thao</Authors>
		<Company>NAAN</Company>
		<Product>Foldable.Maui</Product>
		<Description>Modern .NET MAUI library for detecting foldable device posture, hinge angle, and rendering responsive split layouts.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/jinkun1998/Foldable.Maui</RepositoryUrl>
		<PackageTags>maui;foldable;dual-screen;hinge-angle;surface-duo;galaxy-z-fold;pixel-fold;responsive</PackageTags>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<PackageReference Include="Xamarin.AndroidX.Window" Version="1.4.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Window.WindowJava" Version="1.4.0.1" />
	</ItemGroup>

</Project>
